# Append to the VM's ~/.ssh/config. One alias per host, one key per host.
# Each key is locked to run-job on its host (authorized_keys: restrict,command=...).

# The Mac, as seen from the VM: `ip route | grep default` (usually 10.211.55.2).
Host mac
    HostName 10.211.55.2
    User gpuworker
    IdentityFile ~/.ssh/rjob_mac
    IdentitiesOnly yes

# A Linux server (docs/server-setup.md). List it in a project's rjob.toml to use it.
Host gpuserver
    HostName gpu.example.org
    User gpuworker
    IdentityFile ~/.ssh/rjob_gpuserver
    IdentitiesOnly yes
    ServerAliveInterval 60
    ConnectTimeout 10        # a stopped cloud VM drops packets: fail in 10 s, not minutes
#   ProxyJump bastion.example.org   # only if the server is not directly reachable
