from pathlib import Path

STATE = Path(os.environ.get("RJOB_STATE", Path.home() / ".local/state/rjob")).expanduser()
DEFAULT_RUNS = Path(os.environ.get("RJOB_RUNS_DIR", Path.home() / "rjob-runs")).expanduser()
BATCH_BYTES = 256 << 20   # resume granularity; the transfer itself is streamed
TERMINAL = {"done", "failed", "cancelled", "timeout", "dead"}
GPU_DEVICES = ("mps", "cuda", "gpu", "auto")
PROJECT_FILE = "rjob.toml"
DEFAULT_TIMEOUT_HOURS = 24  # the host runner's default for resources.timeout_hours
POWER_CONFIG = Path(os.environ.get("RJOB_POWER_CONFIG", Path.home() / ".config/rjob/power.toml")).expanduser()
PROVIDERS = Path(__file__).resolve().parents[1] / "host/power"   # providers/ shared with the host watchdog


def die(msg: str, code: int = 2):
    print(f"rjob: {msg}", file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------------ transport

def ssh_cmd(host: str, words: list[str]) -> list[str]:
    base = shlex.split(os.environ.get("RJOB_SSH", "ssh -o BatchMode=yes -o ConnectTimeout=15"))
    return base + [host, shlex.join(words)]


def remote_failed(host: str, words: list[str], p) -> None:
    msg = f"{words[0]} failed: {p.stderr.decode(errors='replace').strip()}"
    try:
        managed = p.returncode == 255 and host in power_hosts(quiet=True)  # ssh could not connect
    except Exception:  # a broken power.toml must not hide the real error
        managed = False
    if managed:
        msg += f"\n{host} is a cloud host and may be stopped: rjob power status {host}; rjob power start {host}"
    die(msg, p.returncode or 1)


def remote(host: str, words: list[str], stdin: bytes | None = None, check=True) -> bytes:
    p = subprocess.run(ssh_cmd(host, words), input=stdin or b"", capture_output=True)
    if check and p.returncode != 0:
        remote_failed(host, words, p)
    return p.stdout


def remote_stream(host: str, words: list[str], stdin_file) -> bytes:
    p = subprocess.run(ssh_cmd(host, words), stdin=stdin_file, capture_output=True)
    if p.returncode != 0:
        remote_failed(host, words, p)
    return p.stdout


# ----------------------------------------------------------------- local git

def git(repo: Path, *args) -> str:
    return subprocess.run(["git", "-C", str(repo), *args], check=True,
                          capture_output=True, text=True).stdout.strip()


def repo_name(repo: Path) -> str:
    try:
        url = git(repo, "config", "remote.origin.url")
    except subprocess.CalledProcessError:
        return repo.resolve().name
    return url.rstrip("/").rsplit("/", 1)[-1].removesuffix(".git")


def require_clean(repo: Path) -> None:
    dirty = git(repo, "status", "--porcelain", "--ignore-submodules=none", "--untracked-files=no")
    if dirty:
        die(f"{repo} has uncommitted changes; commit them on an experiment branch first:\n{dirty}")


def submodules(repo: Path) -> dict:
    """{path: {"repo": name, "sha": checked-out sha, "local": Path}} for initialised submodules."""
    out = {}
    if not (repo / ".gitmodules").exists():
        return out
    status = subprocess.run(["git", "-C", str(repo), "submodule", "status"], check=True,
                            capture_output=True, text=True).stdout  # not stripped: col 0 is a flag
    for line in status.splitlines():
        sha, path = line[1:].split()[:2]
        if line[0] == "-":
            die(f"submodule {path} is not initialised")
        local = repo / path
        out[path] = {"repo": repo_name(local), "sha": sha, "local": local}
    return out


def push_commit(host: str, local: Path, name: str, sha: str) -> None:
    """Send `sha` as refs/rjob/<sha> in an incremental bundle, unless the host has it."""
    if not remote(host, ["has", name, sha]).strip():
        return
    known = remote(host, ["refs", name]).decode().split()
    known = [k for k in known if subprocess.run(["git", "-C", str(local), "cat-file", "-e", f"{k}^{{commit}}"],
                                                 capture_output=True).returncode == 0]
    ref = f"refs/rjob/{sha}"
    git(local, "update-ref", ref, sha)
    try:
        bundle = subprocess.run(["git", "-C", str(local), "bundle", "create", "-", ref,
                                 *[f"^{k}" for k in known]], check=True, capture_output=True).stdout
    finally:
        git(local, "update-ref", "-d", ref)
    remote(host, ["push", name], stdin=bundle)
    print(f"pushed {name}@{sha[:12]} ({len(bundle) / 2**20:.1f} MiB)", file=sys.stderr)


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def put_data(host: str, path: Path) -> str:
    digest = sha256(path)
    if remote(host, ["has-data", digest]).strip():
        with open(path, "rb") as fh:
            remote_stream(host, ["put-data", digest], fh)
        print(f"uploaded {path} ({path.stat().st_size / 2**20:.1f} MiB)", file=sys.stderr)
    return f"sha256:{digest}"


# ---------------------------------------------------------- project + hosts

def load_project(explicit: str | None, start: Path | None = None, spec: dict | None = None) -> dict:
    """The project file as a dict (+ "_dir"), or {} when there is none."""
    ref, base = explicit or os.environ.get("RJOB_PROJECT"), Path.cwd()
    if not ref and (spec or {}).get("project"):
        ref, base = spec["project"], start  # relative to job.toml
    if ref:
        path = base / os.path.expanduser(ref)
        path = path / PROJECT_FILE if path.is_dir() else path
        if not path.is_file():
            die(f"project file {path} not found")
    else:
        d = (start or Path.cwd()).resolve()
        for cand in [d, *d.parents]:
            if (cand / PROJECT_FILE).is_file():
                path = cand / PROJECT_FILE
                break
        else:
            return {}
    proj = tomllib.loads(path.read_text())
    proj["_dir"] = path.parent
    for h in proj.get("hosts", []):
        if "alias" not in h:
            die(f"{path}: every [[hosts]] entry needs an alias")
        for key, low in (("cost_per_hour", 0), ("max_hours", None)):
            v = h.get(key)
            if v is not None and (isinstance(v, bool) or not isinstance(v, (int, float))
                                  or (v < low if low is not None else v <= 0)):
                die(f"{path}: host {h['alias']}: {key} must be a number {'>= 0' if low is not None else '> 0'}")
    return proj


def host_entry(proj: dict, alias: str) -> dict:
    """The project's [[hosts]] entry for alias, or {} (a host outside the list has no cost and no limit)."""
    return next((h for h in proj.get("hosts", []) if h["alias"] == alias), {})


def job_hours(res: dict) -> float:
    return float(res.get("timeout_hours", DEFAULT_TIMEOUT_HOURS))


def too_long(entry: dict, res: dict) -> str | None:
    """Why the host would rather not take a job this long, or None."""
    limit = entry.get("max_hours")
    if limit is not None and job_hours(res) > limit:
        return f"max_hours {limit:g} < timeout_hours {job_hours(res):g}"
    return None


def project_hosts(proj: dict) -> list[str]:
    return [h["alias"] for h in proj.get("hosts", [])]


def default_host(a) -> str:
    """Host for commands that are not about one job (list, info, put-data, ...)."""
    if a.host or os.environ.get("RJOB_HOST"):
        return a.host or os.environ["RJOB_HOST"]
    hosts = project_hosts(load_project(a.project))
    return hosts[0] if hosts else "mac"


def host_info(host: str) -> dict | None:
    """`info brief` from the host, or full `info` from runners that predate it; None if unreachable."""
    for words in (["info", "brief"], ["info"]):
        p = subprocess.run(ssh_cmd(host, words), stdin=subprocess.DEVNULL, capture_output=True)
        if p.returncode == 0:
            try:
                return json.loads(p.stdout)
            except json.JSONDecodeError:
                return None
        if p.returncode != 2 or b"usage:" not in p.stderr:  # 2 + usage: verb form unknown, retry
            return None
    return None


def host_infos(hosts: list[str]) -> dict[str, dict | None]:
    """host_info for several hosts in parallel (one slow or dead host costs one timeout)."""
    if not hosts:
        return {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(hosts)) as ex:
        return dict(zip(hosts, ex.map(host_info, hosts)))


def info_devices(info: dict) -> set[str]:
    if "devices" in info:
        return set(info["devices"])
    dp = info.get("default_python", {})  # host runner predating multi-host
    return {"cpu"} | {d for d in ("mps", "cuda") if dp.get(d)}


def needs(res: dict) -> tuple[int, int, float]:
    gpus = int(res.get("gpus", 1)) if res.get("device", "cpu") in GPU_DEVICES else 0
    return gpus, int(res.get("cpus", 1)), float(res.get("mem_gb", 0))


def can_run(device: str, devices: set[str]) -> bool:
    if device in ("mps", "cuda"):
        return device in devices
    if device == "gpu":
        return bool({"mps", "cuda"} & devices)
    return True


def fits_now(info: dict, res: dict) -> bool | None:
    """True/False from the host's free capacity; None when the host does not report it."""
    free, slots = info.get("free"), info.get("slots", {})
    if free is None:
        return None
    g, c, m = needs(res)
    if res.get("device") == "auto" and not slots.get("gpu"):
        g = 0
    idle = info.get("idle", not info.get("running"))
    cpu_ok = c <= free["cpu"] or idle      # oversize jobs run alone on an idle host
    mem_ok = free.get("mem_gb") is None or m <= free["mem_gb"] or idle
    return g <= free["gpu"] and cpu_ok and mem_ok and not info.get("queue_len")


def place(proj: dict, res: dict, strict: bool = True) -> tuple[str | None, str]:
    """(host, reason) for a new job across the project's hosts. strict=False (dry run)
    returns (None, reason) instead of failing when no host can take the job."""
    device = res.get("device", "cpu")
    gpus = needs(res)[0]
    declared = {h["alias"]: set(h["devices"]) for h in proj["hosts"] if "devices" in h}
    skipped = [f"{a}: no {device}" for a, d in declared.items() if not can_run(device, d)]
    ask = [h["alias"] for h in proj["hosts"] if h["alias"] not in declared or can_run(device, declared[h["alias"]])]
    capable = []
    for alias, info in host_infos(ask).items():
        total_gpus = info.get("slots", {}).get("gpu", 0) if info else 0
        if info is None:
            skipped.append(f"{alias}: unreachable")
        elif not can_run(device, declared.get(alias) or info_devices(info)):
            skipped.append(f"{alias}: no {device}")
        elif gpus > total_gpus and not (device == "auto" and total_gpus == 0):
            skipped.append(f"{alias}: only {total_gpus} GPUs")
        else:
            capable.append((alias, info))
    # max_hours is a preference: a host is passed over for a longer job only while another capable host exists
    longer = {al: why for al, _ in capable if (why := too_long(host_entry(proj, al), res))}
    if len(longer) < len(capable):
        skipped += [f"{al}: {why}" for al, why in longer.items()]
        capable = [(al, info) for al, info in capable if al not in longer]
    elif capable:
        skipped.append(f"no capable host within max_hours ({'; '.join(f'{al}: {w}' for al, w in longer.items())}), using it anyway")
    note = f" (skipped {'; '.join(skipped)})" if skipped else ""
    if not capable:
        if not strict:
            return None, f"no project host can run this job now{note}"
        die(f"no project host can run device={device} with gpus={gpus}{note}")
    for alias, info in capable:
        if fits_now(info, res):
            return alias, f"fits now, free {info['free']}{note}"
    for alias, info in capable:  # old runner: idle means it fits
        if fits_now(info, res) is None and not info.get("running") and not info.get("queued"):
            return alias, f"idle{note}"
    alias, info = min(capable, key=lambda x: len(x[1].get("queued", [])) + len(x[1].get("running", [])))
    return alias, f"no host has room now; shortest queue ({len(info.get('queued', []))} queued){note}"


def choose_host(a, spec: dict, proj: dict) -> tuple[str | None, str]:
    if a.host:
        return a.host, "--host"
    if os.environ.get("RJOB_HOST"):
        return os.environ["RJOB_HOST"], "$RJOB_HOST"
    if spec.get("host"):
        return spec["host"], "job.toml host"
    hosts = project_hosts(proj)
    if len(hosts) == 1:
        why = too_long(proj["hosts"][0], spec.get("resources", {}))
        return hosts[0], "only project host" + (f" ({why}, no other host)" if why else "")
    if hosts:
        return place(proj, spec.get("resources", {}), strict=not a.dry_run)
    return "mac", "default (no project file)"


def job_host(a) -> str:
    """Host of an existing job: --host, else the host recorded at submit, else
    $RJOB_HOST, else the project host that knows the id, else "mac" (as before multi-host)."""
    host = a.host or local_record(a.id).get("host") or os.environ.get("RJOB_HOST")
    if host:
        return host
    hosts = project_hosts(load_project(a.project))
    if not hosts:
        return "mac"

    def knows(h):
        return subprocess.run(ssh_cmd(h, ["status", a.id]), stdin=subprocess.DEVNULL,
                              capture_output=True).returncode == 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(hosts)) as ex:
        found = [h for h, ok in zip(hosts, ex.map(knows, hosts)) if ok]
    if not found:
        die(f"job {a.id} is not in {STATE / 'jobs.jsonl'} and no project host knows it; pass --host")
    return found[0]


# ------------------------------------------------------------------ commands

def resolve_job(spec_path: Path, spec: dict, proj: dict, host: str, dry: bool) -> tuple[dict, Path]:
    base = spec_path.parent
    job = {"name": spec.get("name", spec_path.stem), "resources": spec.get("resources", {}),
           "run": dict(spec["run"])}
    job["run"].setdefault("files", [])
    code = spec.get("code")
    if code:
        local = Path(os.path.expanduser(code["path"]))
        if not local.is_absolute():
            local = (base / local).resolve()
        require_clean(local)
        name = code.get("repo", repo_name(local))
        sha = git(local, "rev-parse", code.get("rev", "HEAD") if code.get("sha", "auto") == "auto" else code["sha"])
        resolved = {"repo": name, "sha": sha, "branch": git(local, "rev-parse", "--abbrev-ref", "HEAD")}
        subs = {}
        overrides = code.get("submodules", {})
        for path, sub in submodules(local).items():
            require_clean(sub["local"])
            ov = overrides.get(path, {})
            s_sha = sub["sha"] if ov.get("sha", "auto") == "auto" else git(sub["local"], "rev-parse", ov["sha"])
            subs[path] = {"repo": ov.get("repo", sub["repo"]), "sha": s_sha}
            if not dry:
                push_commit(host, sub["local"], subs[path]["repo"], s_sha)
        resolved["submodules"] = subs
        if "build_steps" in code:
            resolved["build_steps"] = code["build_steps"]
        if not dry:
            push_commit(host, local, name, sha)
        job["code"] = resolved
    data = {}
    for dest, src in spec.get("data", {}).items():
        p = Path(os.path.expanduser(src))
        p = p if p.is_absolute() else (base / p)
        data[dest] = "dry-run" if dry else put_data(host, p)
    if data:
        job["data"] = data
    runs = spec.get("runs_dir")
    if runs is None and "runs_dir" in proj:
        runs = proj["_dir"] / os.path.expanduser(proj["runs_dir"])
    job["runs_dir"] = str(Path(os.path.expanduser(str(runs or DEFAULT_RUNS))))
    return job, base


def cmd_submit(a) -> None:
    spec_path = Path(a.spec)
    if spec_path.is_dir():
        spec_path = spec_path / "job.toml"
    spec = tomllib.loads(spec_path.read_text())
    proj = load_project(a.project, spec_path.parent, spec)
    host, why = choose_host(a, spec, proj)
    print(f"host: {host or 'none'} ({why})", file=sys.stderr)
    entry, res = host_entry(proj, host), spec.get("resources", {})
    if host and why.startswith(("--host", "$RJOB_HOST", "job.toml host")) and (limit := too_long(entry, res)):
        print(f"warning: {host} is pinned although {limit}", file=sys.stderr)
    rate = float(entry.get("cost_per_hour", 0))
    if host and rate:
        print(f"cost: <= {rate * job_hours(res):.2f} ({rate:g}/h x timeout_hours {job_hours(res):g})", file=sys.stderr)
    job, base = resolve_job(spec_path, spec, proj, host, a.dry_run)
    if a.dry_run:
        print(json.dumps(job, indent=2))
        return
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        raw = json.dumps(job, indent=2).encode()
        info = tarfile.TarInfo("job.json")
        info.size = len(raw)
        tar.addfile(info, io.BytesIO(raw))
        for f in job["run"]["files"]:
            if not (base / f).is_file():
                die(f"run.files entry {f} not found next to {spec_path}")
            tar.add(base / f, arcname=f, recursive=False)
    job_id = remote(host, ["submit"], stdin=buf.getvalue()).decode().strip()
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "jobs.jsonl", "a") as fh:
        fh.write(json.dumps({"id": job_id, "host": host, "submitted": time.strftime("%Y-%m-%dT%H:%M:%S"),
                             "spec": str(spec_path.resolve()), "cost_per_hour": rate,
                             "job": job}) + "\n")
    print(job_id)


def local_record(job_id: str) -> dict:
    rec = {}
    path = STATE / "jobs.jsonl"
    if path.exists():
        for line in path.read_text().splitlines():
            r = json.loads(line)
            if r["id"] == job_id:
                rec = r
    return rec


def cmd_wait(a) -> None:
    host = job_host(a)
    while True:
        st = json.loads(remote(host, ["status", a.id]))
        if st["state"] in TERMINAL:
            print(json.dumps(st))
            sys.exit(0 if st["state"] == "done" else 1)
        time.sleep(a.interval)


def fetch_stream(host: str, job_id: str, paths: list[str], out: Path) -> None:
    """Stream the host's tar.gz straight to disk; never hold a batch in memory (VM has ~3 GB)."""
    proc = subprocess.Popen(ssh_cmd(host, ["fetch", job_id]), stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    proc.stdin.write("\n".join(paths).encode())
    proc.stdin.close()
    try:
        with tarfile.open(fileobj=proc.stdout, mode="r|gz") as tar:
            tar.extractall(out, filter="data")
    finally:
        err = proc.stderr.read().decode(errors="replace").strip()
        if proc.wait() != 0:
            die(f"fetch failed: {err}", proc.returncode or 1)


def cmd_fetch(a) -> None:
    host = job_host(a)
    rec = local_record(a.id)
    dest = Path(a.dest) if a.dest else Path(rec.get("job", {}).get("runs_dir", DEFAULT_RUNS)) / a.id
    out = dest / "outputs"
    out.mkdir(parents=True, exist_ok=True)
    manifest = json.loads(remote(host, ["manifest", a.id]))
    if a.include:
        manifest = [m for m in manifest if any(fnmatch.fnmatch(m["path"], g) for g in a.include)]
    todo = [m for m in manifest if not ((out / m["path"]).is_file()
                                        and (out / m["path"]).stat().st_size == m["size"]
                                        and sha256(out / m["path"]) == m["sha256"])]
    need = sum(m["size"] for m in todo)
    free = shutil.disk_usage(dest).free
    if need > free * 0.9:
        die(f"need {need / 2**30:.2f} GiB but only {free / 2**30:.2f} GiB free at {dest}; use --include")
    batch, size = [], 0
    for m in todo + [None]:
        if m is not None:
            batch.append(m)
            size += m["size"]
        if batch and (m is None or size >= BATCH_BYTES):
            fetch_stream(host, a.id, [b["path"] for b in batch], out)
            batch, size = [], 0
    bad = [m["path"] for m in todo if sha256(out / m["path"]) != m["sha256"]]
    (dest / "manifest.json").write_text(json.dumps(manifest, indent=2))
    (dest / "provenance.json").write_bytes(remote(host, ["provenance", a.id]))
    (dest / "status.json").write_bytes(remote(host, ["status", a.id]))
    (dest / "log.txt").write_bytes(remote(host, ["logs", a.id, "100000"]))
    if bad:
        die(f"checksum mismatch: {bad}", 1)
    print(f"{dest}  ({len(todo)} fetched, {len(manifest) - len(todo)} already present, "
          f"{need / 2**20:.1f} MiB)")


def passthrough(words, by_id=False):
    def fn(a):
        args = [getattr(a, w[1:]) if w.startswith("$") else w for w in words]
        host = job_host(a) if by_id else default_host(a)
        sys.stdout.buffer.write(remote(host, [x for x in args if x is not None]))
    return fn


def cmd_cleanup(a) -> None:
    if a.what == "job":
        a.id = a.arg
        host = job_host(a)
    else:
        host = default_host(a)
    sys.stdout.buffer.write(remote(host, ["cleanup", a.what, a.arg]))


def all_hosts(a) -> list[str]:
    hosts = project_hosts(load_project(a.project))
    if not hosts:
        die("no project file with [[hosts]] found; pass --project or set $RJOB_PROJECT")
    return hosts


def cmd_hosts(a) -> None:
    proj = load_project(a.project)
    print("host\tdevices\tgpu free/total\tcpu free/total\tmem_gb free/total\trunning\tqueued\tcost/h\tmax_hours")
    for host, info in host_infos(all_hosts(a)).items():
        entry = host_entry(proj, host)
        terms = f"\t{entry.get('cost_per_hour', 0):g}\t{entry.get('max_hours', '-')}"
        if info is None:
            print(f"{host}\tunreachable{chr(9) * 6}{terms}")
            continue
        slots, free = info.get("slots", {}), info.get("free") or {}
        def pair(k):
            f, t = free.get(k, "?"), slots.get(k)
            f = round(f, 1) if isinstance(f, float) else f
            return f"{f}/{t if t is not None else '-'}"
        print(f"{host}\t{','.join(sorted(info_devices(info)))}\t{pair('gpu')}\t{pair('cpu')}\t{pair('mem_gb')}"
              f"\t{len(info.get('running', []))}\t{len(info.get('queued', []))}{terms}")


def busy_hours(st: dict) -> float | None:
    """Hours the job held its host: from start (build included) to finish, or to now while it runs."""
    if not st.get("started"):
        return None
    try:
        t0 = datetime.datetime.strptime(st["started"], "%Y-%m-%dT%H:%M:%S%z")
        t1 = (datetime.datetime.strptime(st["finished"], "%Y-%m-%dT%H:%M:%S%z") if st.get("finished")
              else datetime.datetime.now(datetime.timezone.utc))
    except (TypeError, ValueError):  # a runner with another timestamp format: unpriced, not fatal
        return None
    return (t1 - t0).total_seconds() / 3600


def cmd_cost(a) -> None:
    """Hours and cost of the recorded jobs, at the cost_per_hour each job was submitted with."""
    path = STATE / "jobs.jsonl"
    recs = [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []
    recs = [r for r in recs if (not a.since or r["submitted"] >= a.since) and (not a.host or r["host"] == a.host)]

    def status(r):
        p = subprocess.run(ssh_cmd(r["host"], ["status", r["id"]]), stdin=subprocess.DEVNULL, capture_output=True)
        try:
            return json.loads(p.stdout) if p.returncode == 0 else None
        except json.JSONDecodeError:
            return None
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        sts = list(ex.map(status, recs))
    print("id\thost\tname\tstate\thours\tcost/h\tcost")
    totals: dict[str, list[float]] = {}
    for r, st in zip(recs, sts):
        rate = float(r.get("cost_per_hour", 0))
        hours = busy_hours(st) if st else None
        state = st["state"] if st else "unknown"
        cost = rate * hours if hours is not None else None
        print(f"{r['id']}\t{r['host']}\t{r['job']['name']}\t{state}\t"
              f"{'-' if hours is None else f'{hours:.2f}'}\t{rate:g}\t{'-' if cost is None else f'{cost:.2f}'}")
        t = totals.setdefault(r["host"], [0.0, 0.0])
        t[0] += hours or 0
        t[1] += cost or 0
    for host, (hours, cost) in totals.items():
        print(f"total\t{host}\t\t\t{hours:.2f}\t\t{cost:.2f}")
    if totals:
        print(f"total\tall\t\t\t{sum(t[0] for t in totals.values()):.2f}\t\t{sum(t[1] for t in totals.values()):.2f}")


# --------------------------------------------------------------------- power

def power_hosts(quiet: bool = False) -> dict:
    """The [hosts.<alias>] tables of the VM's power.toml; {} when there is none."""
    if not POWER_CONFIG.is_file():
        return {}
    if POWER_CONFIG.stat().st_mode & 0o077:
        if quiet:
            return {}
        die(f"{POWER_CONFIG} is readable by others; chmod 600 it (it names the cloud key)")
    return tomllib.loads(POWER_CONFIG.read_text()).get("hosts", {})


def power_provider(alias: str):
    """(module, provider config) for a host in power.toml. Clients use only state() and start()."""
    entry = power_hosts().get(alias)
    if entry is None:
        die(f"{alias} is not in {POWER_CONFIG}; rjob power starts only hosts listed there (docs/power.md)")
    name = entry.get("provider", "")
    if not re.match(r"^[a-z][a-z0-9_]{0,30}$", name):
        die(f"{POWER_CONFIG}: hosts.{alias}.provider must name a module in host/power/providers")
    if str(PROVIDERS) not in sys.path:
        sys.path.insert(0, str(PROVIDERS))
    return importlib.import_module(f"providers.{name}"), dict(entry.get(name, {}))


def provider_state(alias: str) -> str:
    mod, cfg = power_provider(alias)
    try:
        return mod.state(cfg)
    except Exception as exc:  # ProviderError, or a missing CLI
        return f"error: {exc}"


def power_status_row(alias: str, rate: float) -> str:
    state = provider_state(alias)
    info = host_info(alias) if state == "RUNNING" else None
    pw = (info or {}).get("power") or {}
    auto = pw.get("autostop") or {}
    jobs = f"{len(info.get('running', []))}/{len(info.get('queued', []))}" if info else "-"
    if state == "RUNNING" and info is None:
        decision = "runner not answering yet"
    elif info and not pw:
        decision = "runner without autostop"
    else:
        decision = auto.get("decision") or ("stopping" if pw.get("stopping") else "-")
    return (f"{alias}\t{state}\t{rate:g}\t{jobs}\t{decision}\t{pw.get('hold_until') or '-'}"
            f"\t{auto.get('stop_at') or '-'}\t{'yes' if pw.get('stop_requested') else '-'}")


def power_start(alias: str, rate: float, wait: bool, timeout: float) -> None:
    """Start a stopped host (idempotent; one starter per alias), then wait for its runner."""
    mod, cfg = power_provider(alias)
    STATE.mkdir(parents=True, exist_ok=True)
    t0 = time.time()
    with open(STATE / f"power-{alias}.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        while True:
            try:
                state = mod.state(cfg)
            except Exception as exc:
                die(f"{alias}: cannot read the cloud state: {exc}")
            if state == "STOPPED":
                print(f"starting {alias}" + (f" ({rate:g}/h)" if rate else ""), file=sys.stderr)
                try:
                    mod.start(cfg)
                except Exception as exc:
                    die(f"{alias}: start failed: {exc}")
                break
            if state in ("RUNNING", "STARTING"):
                break
            if state != "STOPPING" or time.time() - t0 > timeout:
                die(f"{alias}: cloud state {state}; not starting it")
            time.sleep(10)  # a stop in progress: start once it has finished
    if not wait:
        return
    while host_info(alias) is None:
        if time.time() - t0 > timeout:
            die(f"{alias} did not answer within {timeout:.0f} s after the start; rjob power status {alias}")
        time.sleep(10)
    print(f"{alias} is up ({time.time() - t0:.0f} s)", file=sys.stderr)


def cmd_power(a) -> None:
    proj = load_project(a.project)
    if a.action == "status":
        aliases = [a.alias] if a.alias else list(power_hosts())
        if not aliases:
            die(f"no hosts in {POWER_CONFIG} (docs/power.md)")
        print("host\tcloud\tcost/h\trunning/queued\tautostop\thold_until\tstop_at\tstop_requested")
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(aliases)) as ex:
            rows = ex.map(lambda al: power_status_row(al, float(host_entry(proj, al).get("cost_per_hour", 0))), aliases)
            for row in rows:
                print(row)
    elif a.action == "start":
        power_start(a.alias, float(host_entry(proj, a.alias).get("cost_per_hour", 0)), not a.no_wait, a.timeout)
    elif a.action == "stop":
        sys.stdout.buffer.write(remote(a.alias, ["request-stop"] + (["cancel"] if a.cancel else [])))
    elif a.action == "hold":
        sys.stdout.buffer.write(remote(a.alias, ["hold", a.hours]))


def cmd_list(a) -> None:
    if not a.all:
        sys.stdout.buffer.write(remote(default_host(a), ["list"]))
        return
    def run_list(host):
        return subprocess.run(ssh_cmd(host, ["list"]), stdin=subprocess.DEVNULL, capture_output=True, text=True)
    hosts = all_hosts(a)
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(hosts)) as ex:
        results = list(ex.map(run_list, hosts))
    for host, p in zip(hosts, results):
        if p.returncode != 0:
            print(f"{host}\tunreachable", file=sys.stderr)
            continue
        for line in p.stdout.splitlines():
            print(f"{host}\t{line}")


def main() -> None:
    ap = argparse.ArgumentParser(prog="rjob", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    common = argparse.ArgumentParser(add_help=False)  # --host/--project also after the command
    for flag, default in (("--host", None), ("--project", None)):
        ap.add_argument(flag, default=default)
        common.add_argument(flag, default=argparse.SUPPRESS,
                            help="ssh alias; overrides placement and the recorded host" if flag == "--host"
                            else "project dir or rjob.toml (default: $RJOB_PROJECT or nearest rjob.toml)")
    sp = ap.add_subparsers(dest="cmd", required=True)
    real_add = sp.add_parser
    sp.add_parser = lambda name, **kw: real_add(name, parents=[common], **kw)
    p = sp.add_parser("submit"); p.add_argument("spec"); p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_submit)
    for name in ("status", "cancel", "provenance", "manifest"):
        p = sp.add_parser(name); p.add_argument("id"); p.set_defaults(fn=passthrough([name, "$id"], by_id=True))
    p = sp.add_parser("logs"); p.add_argument("id"); p.add_argument("n", nargs="?", default="100")
    p.set_defaults(fn=passthrough(["logs", "$id", "$n"], by_id=True))
    sp.add_parser("info").set_defaults(fn=passthrough(["info"]))
    p = sp.add_parser("list"); p.add_argument("--all", action="store_true"); p.set_defaults(fn=cmd_list)
    sp.add_parser("hosts").set_defaults(fn=cmd_hosts)
    p = sp.add_parser("cost"); p.add_argument("--since", help="only jobs submitted on or after YYYY-MM-DD")
    p.set_defaults(fn=cmd_cost)
    p = sp.add_parser("power"); pw = p.add_subparsers(dest="action", required=True)
    q = pw.add_parser("status"); q.add_argument("alias", nargs="?")
    q = pw.add_parser("start"); q.add_argument("alias"); q.add_argument("--no-wait", action="store_true")
    q.add_argument("--timeout", type=float, default=600, help="seconds to wait for the runner (default 600)")
    q = pw.add_parser("stop"); q.add_argument("alias"); q.add_argument("--cancel", action="store_true")
    q = pw.add_parser("hold"); q.add_argument("alias"); q.add_argument("hours")
    p.set_defaults(fn=cmd_power)
    p = sp.add_parser("wait"); p.add_argument("id"); p.add_argument("--interval", type=float, default=60)
    p.set_defaults(fn=cmd_wait)
    p = sp.add_parser("fetch"); p.add_argument("id"); p.add_argument("--dest")
    p.add_argument("--include", action="append"); p.set_defaults(fn=cmd_fetch)
    p = sp.add_parser("push"); p.add_argument("path"); p.add_argument("rev", nargs="?", default="HEAD")
    p.set_defaults(fn=lambda a: push_commit(default_host(a), Path(a.path), repo_name(Path(a.path)),
                                            git(Path(a.path), "rev-parse", a.rev)))
    p = sp.add_parser("put-data"); p.add_argument("file")
    p.set_defaults(fn=lambda a: print(put_data(default_host(a), Path(a.file))))
    p = sp.add_parser("cleanup"); p.add_argument("what", choices=["job", "builds"]); p.add_argument("arg")
    p.set_defaults(fn=cmd_cleanup)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
