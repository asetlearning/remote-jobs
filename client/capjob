#!/usr/bin/env python3
"""capjob: run a local job inside a memory/CPU cap; if it is killed, fall back to rjob.

    capjob [--mem 2G] [--swap 1G] [--cpus 2] [--out DIR] [--rjob JOB.toml]
           [--name NAME] [--no-fallback] -- CMD [ARG...]

The command runs in its own systemd user scope (MemoryMax, MemorySwapMax, CPUQuota)
with oom_score_adj 1000, so when memory runs out the job is killed, not Maestri or the
agent sessions. Thread-count variables (OMP_NUM_THREADS etc.) default to --cpus.

If the job is killed (SIGKILL: cap or OOM) and --no-fallback is not given:
  1. --rjob JOB.toml given: `rjob submit JOB.toml`.
  2. Otherwise a job.toml is generated under <project>/jobs/capjob/<name>-<stamp>/ and
     submitted automatically when it is safe: CMD runs inside a git repo with a clean
     tree, --out names the directory (relative to the cwd) where the job writes its
     results, and no argument is an absolute path outside the repo.
  3. Otherwise the draft is left there and capjob exits 75; fix the draft, commit,
     and run `rjob submit <draft>`.
<project> = the nearest rjob.toml above the cwd, else $RJOB_PROJECT, else
~/Research/challenge-gen.

Exit codes: the job's own code when it finishes; 75 killed, draft written (action
needed); 76 killed and submitted to rjob (job id printed). Lines starting "CAPJOB:" are
meant for agents to parse.
"""
# Created by: Alex Myasnikov
# Date: October 16, 2026

import argparse
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_PROJECT = Path.home() / "Research" / "challenge-gen"
THREAD_VARS = ("OMP_NUM_THREADS", "MKL_NUM_THREADS", "OPENBLAS_NUM_THREADS",
               "NUMEXPR_NUM_THREADS", "RAYON_NUM_THREADS", "RJOB_CPUS")
KILLED, SUBMITTED = 75, 76


def say(msg: str) -> None:
    print(f"CAPJOB: {msg}", file=sys.stderr, flush=True)


def size_gb(s: str) -> float:
    m = re.fullmatch(r"(\d+(?:\.\d+)?)([KMGT]?)", s.strip().upper())
    if not m:
        raise argparse.ArgumentTypeError(f"bad size {s!r} (e.g. 512M, 2G)")
    return float(m[1]) * {"K": 2**-20, "M": 2**-10, "G": 1, "T": 1024, "": 2**-30}[m[2]]


def git(*args: str, cwd: Path) -> str | None:
    p = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 else None


def find_project(cwd: Path) -> Path:
    for d in (cwd, *cwd.parents):
        if (d / "rjob.toml").is_file():
            return d
    env = os.environ.get("RJOB_PROJECT")
    return Path(env).expanduser() if env else DEFAULT_PROJECT


def run_capped(a, cmd: list[str], unit: str) -> int:
    env = os.environ.copy()
    for v in THREAD_VARS:
        env.setdefault(v, str(a.cpus))
    argv = ["systemd-run", "--user", "--scope", "--quiet", "--collect", f"--unit={unit}",
            "-p", f"MemoryMax={int(a.mem * 1024)}M",
            "-p", f"MemorySwapMax={int(a.swap * 1024)}M",
            "-p", f"CPUQuota={a.cpus * 100}%",
            "choom", "-n", "1000", "--", *cmd]
    say(f"running in {unit}: mem {gb(a.mem)}, swap {gb(a.swap)}, cpus {a.cpus}")
    return subprocess.run(argv, env=env).returncode


def draft_job(a, cmd: list[str], cwd: Path, project: Path, stamp: str) -> tuple[Path, list[str]]:
    """Write a job.toml for the killed command; return it and the reasons not to auto-submit."""
    blockers: list[str] = []
    top = git("rev-parse", "--show-toplevel", cwd=cwd)
    if top is None:
        blockers.append("the cwd is not inside a git repo (rjob ships code by commit)")
        repo, rel = cwd, Path(".")
    else:
        repo = Path(top)
        rel = cwd.resolve().relative_to(repo.resolve())
        if git("status", "--porcelain", "--ignore-submodules=dirty", cwd=repo):
            blockers.append(f"{repo} has uncommitted changes; commit them on a branch")
    for arg in cmd:
        for tok in re.split(r"[=,:]", arg):
            if tok.startswith(("/", "~")):
                p = Path(tok).expanduser()
                if top is None or not str(p.resolve()).startswith(str(repo.resolve()) + os.sep):
                    blockers.append(f"argument path {tok} is outside the repo; ship it via "
                                    "[run] files or [data] instead")
    if not a.out:
        blockers.append("--out not given, so it is unknown which directory to return")
    shell = shlex.join(cmd) if rel == Path(".") else f"cd {shlex.quote(str(rel))} && exec {shlex.join(cmd)}"
    outputs = str(rel / a.out) if a.out else "outputs"
    mem_gb = max(4, int(a.mem * 2 + 0.999))
    job_dir = project / "jobs" / "capjob" / f"{a.name}-{stamp}"
    job_dir.mkdir(parents=True, exist_ok=True)
    spec = job_dir / "job.toml"
    toml = [
        "# Generated by capjob after the local run was killed at its memory cap.",
        f"# Local cap: mem {gb(a.mem)}, cpus {a.cpus}; mem_gb below is twice that (min 4).",
        *(f"# NOT auto-submitted: {b}" for b in blockers),
        f'name = "capjob-{a.name}"',
        f'runs_dir = "{project / "runs"}"',
        "",
        "[code]",
        f'path = "{repo}"',
        "",
        "[resources]",
        'device = "cpu"',
        f"cpus = {max(a.cpus, 4)}",
        f"mem_gb = {mem_gb}",
        "timeout_hours = 24",
        "",
        "[run]",
        f"argv = {toml_list(['sh', '-c', shell])}",
        f'outputs = "{outputs}"',
        "",
    ]
    spec.write_text("\n".join(toml))
    return spec, blockers


def toml_list(items: list[str]) -> str:
    return "[" + ", ".join('"' + i.replace("\\", "\\\\").replace('"', '\\"') + '"' for i in items) + "]"


def submit(spec: Path) -> int:
    say(f"submitting {spec} to rjob")
    p = subprocess.run(["rjob", "submit", str(spec)], capture_output=True, text=True)
    sys.stderr.write(p.stderr)
    if p.returncode != 0:
        say(f"rjob submit failed (exit {p.returncode}); fix {spec} and submit it by hand")
        return KILLED
    job_id = p.stdout.strip().splitlines()[-1] if p.stdout.strip() else "?"
    say(f"submitted to rjob as {job_id}; follow with: rjob wait {job_id} && rjob fetch {job_id}")
    print(job_id)
    return SUBMITTED


def default_name(cmd: list[str]) -> str:
    """Script or module name for python/uv commands, else the program name."""
    words = [w for w in cmd if w not in ("uv", "run", "python", "python3")]
    for i, w in enumerate(words):
        if w == "-m" and i + 1 < len(words):
            return words[i + 1].rsplit(".", 1)[-1]
        if w == "-c":
            return "python-c"
        if not w.startswith("-"):
            return Path(w).stem
    return Path(cmd[0]).stem


def gb(x: float) -> str:
    return f"{x:g}G" if x >= 1 else f"{x * 1024:.0f}M"


def main() -> int:
    ap = argparse.ArgumentParser(prog="capjob", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--mem", type=size_gb, default=2.0, help="memory cap (default 2G)")
    ap.add_argument("--swap", type=size_gb, default=1.0, help="swap cap (default 1G)")
    ap.add_argument("--cpus", type=int, default=2, help="CPU quota and thread vars (default 2)")
    ap.add_argument("--out", help="results directory, relative to the cwd (for the rjob fallback)")
    ap.add_argument("--rjob", type=Path, help="job.toml to submit if the local run is killed")
    ap.add_argument("--name", help="job name (default: the command's basename)")
    ap.add_argument("--no-fallback", action="store_true", help="never fall back to rjob")
    ap.add_argument("cmd", nargs=argparse.REMAINDER)
    a = ap.parse_args()
    cmd = a.cmd[1:] if a.cmd[:1] == ["--"] else a.cmd
    if not cmd:
        ap.error("no command given (use: capjob [options] -- CMD ...)")
    a.name = re.sub(r"[^A-Za-z0-9_.-]+", "-", a.name or default_name(cmd))[:40].strip("-") or "job"
    stamp = time.strftime("%Y%m%d-%H%M%S")
    unit = f"capjob-{a.name}-{stamp}-{os.getpid()}"

    rc = run_capped(a, cmd, unit)
    if rc not in (137, -9):
        return rc
    say(f"job was killed (exit {rc}): it hit its {gb(a.mem)} memory cap or the system ran out of memory")
    if a.no_fallback:
        return KILLED
    if a.rjob:
        return submit(a.rjob.expanduser().resolve())
    cwd = Path.cwd()
    spec, blockers = draft_job(a, cmd, cwd, find_project(cwd), stamp)
    if blockers:
        for b in blockers:
            say(f"not auto-submitted: {b}")
        say(f"draft job spec: {spec}; fix it, then run: rjob submit {spec}")
        return KILLED
    return submit(spec)


if __name__ == "__main__":
    sys.exit(main())
